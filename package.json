{
  "name": "@dyikai/dsh-hogwarts-loop",
  "version": "1.0.0",
  "description": "Hogwarts-loop as a DeepSeek Harness plugin: per-role subagent dispatch on configurable models, with a client settings page.",
  "author": "dyikai",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skill/SKILL.md",
    "skill/references/*.md",
    "skill/assets/*.md",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hogwarts-loop",
    "subagent",
    "agent-orchestration"
  ],
  "homepage": "https://github.com/dyikai/dsh-hogwarts-loop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyikai/dsh-hogwarts-loop.git"
  },
  "bugs": {
    "url": "https://github.com/dyikai/dsh-hogwarts-loop/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
