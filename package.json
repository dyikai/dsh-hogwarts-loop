{
  "name": "@dyikai/dsh-hogwarts-loop",
  "version": "1.0.0",
  "private": true,
  "description": "Hogwarts-loop as a profile plugin: registers the plan→build→review→commit skill, a per-role subagent dispatcher, and a Plugins-page form for configuring each cast member's model.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skill/SKILL.md",
    "skill/references/*.md",
    "skill/assets/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
